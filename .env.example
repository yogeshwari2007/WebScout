# WebScout Environment Configuration

# Google Gemini API Key (Required for AI Research Analysis)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Playwright Browser Automation Settings
PLAYWRIGHT_HEADLESS=true
SCRAPER_TIMEOUT_MS=25000

# Content Extraction & Safety Limits
MAX_CONTENT_CHARS_PER_PAGE=18000
MAX_URLS_PER_RESEARCH=5

# WebScout Backend Environment Configuration
PROJECT_NAME="WebScout API"
VERSION="0.1.0"
DEBUG=true

# Engine Configuration
# FETCHER options: 'playwright' | 'mock'
FETCHER=playwright
# ANALYZER options: 'auto' (uses Gemini when GEMINI_API_KEY is set), 'gemini', or 'mock'
ANALYZER=auto
MAX_URLS=5
USE_MOCK=false

# Google Gemini API Key (set locally in .env or in Vercel Project Settings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS Configuration (Comma-separated or single URL)
CORS_ORIGINS=http://localhost:3000

# WebScout Backend Environment Configuration
PROJECT_NAME="WebScout API"
VERSION="0.1.0"
DEBUG=true

# Engine Configuration
# FETCHER options: 'playwright' | 'mock'
FETCHER=playwright
# ANALYZER options: 'mock' (Gemini in Step 8)
ANALYZER=mock
MAX_URLS=5
USE_MOCK=false

# Optional Gemini API Key (for future Step 8)
GEMINI_API_KEY=

# CORS Configuration (Comma-separated or single URL)
CORS_ORIGINS=http://localhost:3000
